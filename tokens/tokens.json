{
  "$description": "Berry Design System — design tokens em formato W3C Design Tokens (DTCG). Fonte estruturada e legível por máquina; o espelho em CSS é tokens.css.",
  "color": {
    "$type": "color",
    "brand": {
      "preto":       { "$value": "#000000", "$description": "Cor principal" },
      "cinza":       { "$value": "#7A7A7A", "$description": "Cor de apoio" },
      "cinza-claro": { "$value": "#F0F0F0", "$description": "Cor secundária" },
      "azul":        { "$value": "#0D30A4", "$description": "Destaque; preenchimentos sólidos" },
      "verde":       { "$value": "#47C97E", "$description": "Destaque; acento e sucesso" },
      "verde-logo":  { "$value": "#5EC072", "$description": "Verde dos anéis do logotipo" }
    },
    "neutral": {
      "900": { "$value": "#1A1A1A" },
      "800": { "$value": "#2A2A2A" },
      "700": { "$value": "#404040" },
      "600": { "$value": "#595959" },
      "400": { "$value": "#999999" },
      "300": { "$value": "#B3B3B3" },
      "200": { "$value": "#CCCCCC" },
      "100": { "$value": "#E8E8E8" },
      "050": { "$value": "#F5F5F5" }
    },
    "functional": {
      "warning":   { "$value": "#F1C232", "$description": "Alerta · sinal de sistema" },
      "error":     { "$value": "#DC2626", "$description": "Erro · sinal de sistema" },
      "azul-text": { "$value": "#3373F5", "$description": "Azul legível para texto sobre fundo escuro" }
    },
    "semantic": {
      "bg-dark":     { "$value": "{color.brand.preto}" },
      "bg-light":    { "$value": "#FFFFFF" },
      "text":        { "$value": "{color.brand.cinza-claro}", "$description": "Texto principal sobre escuro" },
      "text-muted":  { "$value": "{color.brand.cinza}" },
      "accent-dark": { "$value": "{color.brand.verde}", "$description": "Acento pequeno no tema escuro" },
      "accent-light":{ "$value": "{color.brand.azul}", "$description": "Acento pequeno no tema claro" }
    }
  },
  "typography": {
    "family": {
      "$type": "fontFamily",
      "display": { "$value": ["IBM Plex Sans", "-apple-system", "BlinkMacSystemFont", "sans-serif"] },
      "body":    { "$value": ["Inter", "-apple-system", "BlinkMacSystemFont", "sans-serif"] },
      "mono":    { "$value": ["IBM Plex Mono", "ui-monospace", "Menlo", "monospace"] }
    },
    "weight": {
      "$type": "fontWeight",
      "regular":  { "$value": 400 },
      "medium":   { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold":     { "$value": 700 }
    },
    "size": {
      "$type": "dimension",
      "display-xl": { "$value": "72px", "$description": "clamp(48px, 7vw, 72px)" },
      "display-lg": { "$value": "52px", "$description": "clamp(36px, 5vw, 52px)" },
      "h1":         { "$value": "40px", "$description": "clamp(30px, 4vw, 40px)" },
      "h2":         { "$value": "28px" },
      "h3":         { "$value": "22px" },
      "lg":         { "$value": "18px" },
      "base":       { "$value": "16px" },
      "sm":         { "$value": "14px" },
      "xs":         { "$value": "12px" }
    }
  },
  "space": {
    "$type": "dimension",
    "1":  { "$value": "4px" },
    "2":  { "$value": "8px" },
    "3":  { "$value": "12px" },
    "4":  { "$value": "16px" },
    "6":  { "$value": "24px" },
    "8":  { "$value": "32px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" },
    "24": { "$value": "96px" }
  },
  "radius": {
    "$type": "dimension",
    "sm":   { "$value": "8px" },
    "md":   { "$value": "12px" },
    "lg":   { "$value": "16px" },
    "xl":   { "$value": "24px" },
    "pill": { "$value": "999px" }
  },
  "size": {
    "container": { "$type": "dimension", "$value": "1160px" }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast":   { "$value": "100ms" },
      "normal": { "$value": "200ms" },
      "slow":   { "$value": "300ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "smooth": { "$value": [0.4, 0, 0.2, 1] },
      "bounce": { "$value": [0.34, 1.56, 0.64, 1] }
    }
  }
}
